# ==============================================================================
# OmniMetrics Hub & Telegram Report Bot - Configuration Environment
# ==============================================================================

# Core Application Settings
APP_NAME="OmniMetrics Hub"
APP_ENV=production
DEBUG=false
APP_API_KEY="omni_secret_token_change_me_in_prod"

# Database Configuration
# PostgreSQL (Default for Docker Compose):
DATABASE_URL="postgresql+asyncpg://omni_user:omni_secure_pass@db:5432/omni_metrics"
# SQLite (Lightweight single-file fallback):
# DATABASE_URL="sqlite+aiosqlite:///./omni_metrics.db"

# Telegram Bot Interface
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Comma-separated list of numeric Telegram User IDs authorized to interact with the bot
# Use @userinfobot on Telegram to get your user ID
ALLOWED_TELEGRAM_USERS="123456789,987654321"

# MAX Messenger Bot Interface (Мессенджер МАКС)
# Получите токен в настройках бота на https://dev.max.ru или в @MasterBot
MAX_BOT_TOKEN="your_max_bot_token_here"
MAX_API_URL="https://platform-api2.max.ru"
# Разрешенные ID пользователей или чатов в МАКС (оставьте пустым для демо-доступа)
ALLOWED_MAX_USERS=""
MAX_DEFAULT_CHAT_ID=""

# AI Executive Analyst Configuration
# Options: "heuristic" (zero-dependency rule-based), "openai", "anthropic", "ollama", "none"
AI_PROVIDER="heuristic"
# Model override (optional; defaults to gpt-4o-mini / claude-3-5-sonnet / llama3)
AI_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Google Sheets Live Synchronization
# Path to local Service Account JSON credentials file
GSHEETS_SERVICE_ACCOUNT_FILE="service_account.json"
# Or raw JSON / Base64-encoded Service Account string
GSHEETS_SERVICE_ACCOUNT_JSON=""

# Automated Scheduler Settings (APScheduler)
SCHEDULER_ENABLED=true
# 5-field Cron format: MINUTE HOUR DAY MONTH DAY_OF_WEEK (UTC)
CRON_MORNING_REPORT="0 9 * * 1-5"
# Chat ID to receive automated morning reports (defaults to first allowed user)
DEFAULT_SCHEDULED_CHAT_ID=""
DEFAULT_SCHEDULED_REPORT_ID="ecommerce_summary"

# PDF & Rendering Engine
# Options: "auto", "weasyprint", "playwright"
PDF_ENGINE="auto"
OUTPUT_DIR="./output"
