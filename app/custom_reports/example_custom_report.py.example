"""Example Custom Report Plugin: Server & Infrastructure Telemetry.

To activate this plugin:
    cp example_custom_report.py.example server_telemetry_report.py
The OmniMetrics Hub will auto-discover and load it instantly!
"""
from datetime import datetime
from typing import Any, Dict, Optional
from sqlalchemy import func, select
from sqlalchemy.ext.asyncio import AsyncSession

from app.models.metric import MetricRecord
from app.reports.base import BaseReport
from app.services.chart_builder import chart_builder
from app.services.excel_exporter import excel_exporter
from app.services.pdf_renderer import pdf_renderer


class ServerTelemetryReport(BaseReport):
    """Custom report tracking server health, resource utilization, and API error rates."""

    report_id = "server_telemetry"
    display_name = "🖥️ Server Telemetry & SRE Health"
    description = "Infrastructure health: CPU utilization, memory pressure, API latency, and 5xx error rates"

    async def fetch_data(
        self,
        session: AsyncSession,
        start_date: datetime,
        end_date: datetime,
        **kwargs: Any,
    ) -> Dict[str, Any]:
        # Aggregate server metrics
        query = (
            select(
                MetricRecord.name,
                func.avg(MetricRecord.value).label("avg"),
                func.max(MetricRecord.value).label("max"),
                func.sum(MetricRecord.value).label("sum"),
            )
            .where(
                MetricRecord.name.in_([
                    "cpu_utilization",
                    "memory_usage_mb",
                    "api_latency_ms",
                    "http_5xx_errors",
                    "http_requests_total",
                ])
            )
            .where(MetricRecord.timestamp >= start_date)
            .where(MetricRecord.timestamp <= end_date)
            .group_by(MetricRecord.name)
        )
        res = await session.execute(query)
        stats = {row.name: row for row in res.all()}

        avg_cpu = float(stats["cpu_utilization"].avg) if "cpu_utilization" in stats else 42.5
        avg_mem = float(stats["memory_usage_mb"].avg) if "memory_usage_mb" in stats else 3400.0
        avg_lat = float(stats["api_latency_ms"].avg) if "api_latency_ms" in stats else 85.2
        sum_5xx = float(stats["http_5xx_errors"].sum) if "http_5xx_errors" in stats else 12.0
        sum_req = float(stats["http_requests_total"].sum) if "http_requests_total" in stats else 150000.0

        error_rate = ((sum_5xx / sum_req) * 100.0) if sum_req > 0 else 0.0

        return {
            "avg_cpu": avg_cpu,
            "avg_mem": avg_mem,
            "avg_latency": avg_lat,
            "sum_5xx": int(sum_5xx),
            "sum_requests": int(sum_req),
            "error_rate": error_rate,
            "kpis": {
                "avg_cpu": f"{avg_cpu:.1f}%",
                "avg_memory": f"{avg_mem:,.0f} MB",
                "avg_latency": f"{avg_lat:.1f} ms",
                "error_rate": f"{error_rate:.3f}%",
            },
            "deltas": {
                "avg_cpu": 2.1,
                "avg_latency": -5.4,
                "error_rate": -12.0,
            },
        }

    async def render_charts(self, data: Dict[str, Any]) -> Dict[str, bytes]:
        charts: Dict[str, bytes] = {}

        # Resource Utilization Bar Chart
        categories = ["Avg CPU %", "Peak CPU %", "Error Rate x100"]
        values = [data.get("avg_cpu", 40.0), min(data.get("avg_cpu", 40.0) * 1.5, 95.0), data.get("error_rate", 0.05) * 100]
        fig_bar = chart_builder.build_bar_chart(
            categories=categories,
            series={"Value": values},
            title="SRE System Health Indicators",
            x_title="Resource Metric",
            y_title="Index Score",
        )
        charts["health_bar"] = chart_builder.fig_to_png(fig_bar)

        # Standalone Preview Card
        charts["preview_card"] = chart_builder.build_kpi_card_image(
            title="Avg API Latency",
            value_str=f"{data.get('avg_latency', 85.0):.1f} ms",
            delta_str="5.4% improvement",
            is_positive=True,
            subtitle=f"{data.get('error_rate', 0.01):.3f}% Error Rate",
        )
        return charts

    async def generate_pdf(
        self,
        data: Dict[str, Any],
        charts: Dict[str, bytes],
        ai_summary: Optional[str] = None,
    ) -> bytes:
        kpi_cards = [
            {"title": "Avg CPU Load", "value": f"{data.get('avg_cpu', 0):.1f}%", "delta": "+2.1%", "is_positive": False},
            {"title": "Memory Usage", "value": f"{data.get('avg_mem', 0):,.0f} MB", "delta": None, "is_positive": None},
            {"title": "API Latency", "value": f"{data.get('avg_latency', 0):.1f} ms", "delta": "-5.4%", "is_positive": True},
            {"title": "5xx Error Rate", "value": f"{data.get('error_rate', 0):.3f}%", "delta": "-12%", "is_positive": True},
        ]

        chart_containers = []
        if "health_bar" in charts:
            chart_containers.append({
                "title": "System Utilization Metrics",
                "image_base64": pdf_renderer.chart_bytes_to_base64(charts["health_bar"]),
                "description": "Computed aggregate health markers across server nodes.",
            })

        tables = [{
            "title": "Node Telemetry Metrics",
            "headers": ["Metric", "Aggregated Value", "Operational Status"],
            "rows": [
                ["Average CPU Utilization", f"{data.get('avg_cpu', 0):.1f}%", "Optimal (<70%)"],
                ["Average Memory Footprint", f"{data.get('avg_mem', 0):,.0f} MB", "Nominal"],
                ["Mean API Latency", f"{data.get('avg_latency', 0):.1f} ms", "Excellent (<150ms)"],
                ["HTTP 5xx Server Errors", f"{data.get('sum_5xx', 0):,}", "Within SLO"],
                ["Total Requests Served", f"{data.get('sum_requests', 0):,}", "Normal"],
            ],
        }]

        context = {
            "report_title": self.display_name,
            "date_range_label": data.get("date_range_label", "Selected Window"),
            "generated_at": datetime.utcnow().strftime("%Y-%m-%d %H:%M UTC"),
            "ai_summary": ai_summary,
            "kpis": kpi_cards,
            "charts": chart_containers,
            "tables": tables,
        }
        html = pdf_renderer.render_html("base_report.html", context)
        return await pdf_renderer.render_pdf(html)

    async def generate_excel(self, data: Dict[str, Any]) -> bytes:
        wb = excel_exporter.create_workbook()
        ws = wb.active
        ws.title = "SRE Telemetry"

        r = excel_exporter.add_title_block(
            ws,
            title="Infrastructure & SRE Telemetry Report",
            subtitle=f"Generated: {datetime.utcnow().strftime('%Y-%m-%d %H:%M UTC')}",
        )
        kpis = [
            {"title": "Avg CPU Load", "value": f"{data.get('avg_cpu', 0):.1f}%", "delta": "+2.1%", "is_positive": False},
            {"title": "API Latency", "value": f"{data.get('avg_latency', 0):.1f} ms", "delta": "-5.4%", "is_positive": True},
            {"title": "5xx Error Rate", "value": f"{data.get('error_rate', 0):.3f}%", "delta": "-12.0%", "is_positive": True},
        ]
        r = excel_exporter.add_kpi_cards(ws, kpis, start_row=r)

        headers = ["Telemetry Dimension", "Value", "SLO Target"]
        rows = [
            ["CPU Utilization (Avg)", f"{data.get('avg_cpu', 0):.1f}%", "< 75.0%"],
            ["Memory Usage (Avg)", f"{data.get('avg_mem', 0):,.0f} MB", "< 8,192 MB"],
            ["API Response Latency", f"{data.get('avg_latency', 0):.1f} ms", "< 200 ms"],
            ["HTTP 5xx Errors", data.get("sum_5xx", 0), "< 50 total"],
            ["Total Ingested HTTP Requests", data.get("sum_requests", 0), "N/A"],
        ]
        excel_exporter.add_table(ws, headers, rows, start_row=r)
        return excel_exporter.to_bytes(wb)

    def format_telegram_caption(
        self,
        data: Dict[str, Any],
        ai_summary: Optional[str] = None,
    ) -> str:
        lines = [
            f"🖥️ <b>{self.display_name}</b>",
            f"🗓 <i>Window: {data.get('date_range_label', 'Selected Window')}</i>",
            "",
            "<b>SRE Core Vitals:</b>",
            f"• ⚙️ <b>CPU Load</b>: <code>{data.get('avg_cpu', 0):.1f}%</code>",
            f"• ⚡ <b>API Latency</b>: <code>{data.get('avg_latency', 0):.1f} ms</code>",
            f"• 🚨 <b>5xx Errors</b>: <code>{data.get('sum_5xx', 0)}</code> ({data.get('error_rate', 0):.3f}%)",
            f"• 🌐 <b>Total Traffic</b>: <code>{data.get('sum_requests', 0):,}</code> reqs",
        ]
        if ai_summary:
            lines.append("")
            lines.append("🧠 <b>Executive Intelligence Briefing:</b>")
            lines.append(ai_summary)
        return "\n".join(lines)
